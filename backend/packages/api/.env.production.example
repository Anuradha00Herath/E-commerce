# Production/staging environment variables for the backend (Railway/Render).
# This is a reference only — no real values. Set actual values directly in
# the hosting dashboard's environment variable UI, never in a committed file.

NODE_ENV=production

# --- Database & cache (from your Railway/Render managed addons) -----------
# Paste the connection string exactly as the platform gives it to you.
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
REDIS_URL=redis://<user>:<password>@<host>:<port>

# --- This backend's own public URL -----------------------------------------
# The domain Railway/Render assigns (or your custom domain), including https://
MEDUSA_BACKEND_URL=https://<your-backend-domain>
# Same value, also needed at BUILD time — see Dockerfile comment. It gets
# baked into the admin/vendor dashboard JS bundles.
MERCUR_BACKEND_URL=https://<your-backend-domain>

# --- CORS: who is allowed to call this API from a browser -----------------
# Comma-separated, no trailing slash. Must include your Vercel storefront URL.
STORE_CORS=https://<your-storefront-domain>.vercel.app
ADMIN_CORS=https://<your-backend-domain>
VENDOR_CORS=https://<your-backend-domain>
AUTH_CORS=https://<your-storefront-domain>.vercel.app,https://<your-backend-domain>

# --- Secrets — generate fresh, unique values for this environment. --------
# Never reuse the values from your local .env. Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-new-random-value>
COOKIE_SECRET=<generate-a-new-random-value>

# --- Vendor dashboard base URL (used in team-invite emails/links) ---------
MERCUR_VENDOR_URL=https://<your-backend-domain>/seller

# --- Storefront on-demand revalidation -------------------------------------
# URL is the deployed Vercel storefront's revalidate endpoint. Secret must be
# the SAME value as REVALIDATE_SECRET in the storefront's env (different var
# name, same value — that's intentional, it's how the two sides authenticate
# the webhook call to each other).
STOREFRONT_REVALIDATE_URL=https://<your-storefront-domain>.vercel.app
STOREFRONT_REVALIDATE_SECRET=<generate-a-new-random-value>

# --- File uploads -----------------------------------------------------------
# KNOWN STAGING LIMITATION: this project currently uses the local file
# storage provider, which writes to the container's own disk. Railway/Render
# containers are ephemeral — any file uploaded through the admin (e.g. a
# product image uploaded via the dashboard, not a seeded external URL) will
# be LOST on the next deploy or restart. Fine for an initial staging check,
# but before real use, swap in an S3-compatible storage provider
# (@medusajs/medusa/file-s3) — not set up here, out of scope for this pass.
FILE_BACKEND_URL=https://<your-backend-domain>/static
