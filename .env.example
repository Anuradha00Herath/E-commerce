# Copy this file to .env and adjust values as needed.
# .env is gitignored and must never be committed.

# --- PostgreSQL ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=changeme
POSTGRES_DB=marketplace
# Host port is remapped to 5433 because 5432 is already in use by another
# local project's container. Internally the container still listens on 5432.
POSTGRES_HOST_PORT=5433

# --- Redis ---
# Host port is remapped to 6380 because 6379 is already in use by another
# local project's container. Internally the container still listens on 6379.
REDIS_HOST_PORT=6380
