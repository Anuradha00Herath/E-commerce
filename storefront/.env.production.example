# Production environment variables for the storefront (Vercel).
# Reference only — no real values. Set actual values in the Vercel project's
# Settings → Environment Variables UI, never in a committed file.

# --- Backend connection -----------------------------------------------------
MEDUSA_BACKEND_URL=https://<your-backend-domain>
# Generate fresh in the deployed Admin dashboard (Settings → API Key
# Management → Publishable Keys) — do NOT reuse the local dev key.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=<generate-in-production-admin>

# --- This app's own public URL ---------------------------------------------
NEXT_PUBLIC_BASE_URL=https://<your-storefront-domain>.vercel.app

# --- Storefront config -------------------------------------------------------
# Matches the region seeded on the backend (see seed-demo-vendor.ts) — change
# if you seed a different region in staging.
NEXT_PUBLIC_DEFAULT_REGION=lk

# Vendor panel link-out (not required for browsing/checkout to work)
NEXT_PUBLIC_VENDOR_URL=https://<your-backend-domain>/seller

# --- Payments (out of scope this sprint per CLAUDE.md) ----------------------
# Inert placeholder — do not use for real payment flows until Stripe is
# actually wired up.
NEXT_PUBLIC_STRIPE_KEY=not-configured-this-sprint

# --- On-demand revalidation --------------------------------------------------
# Must be the SAME value as STOREFRONT_REVALIDATE_SECRET on the backend
# (different var name, same secret — that's how the two sides authenticate
# the webhook call to each other). Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=<generate-a-new-random-value>

# --- Metadata -----------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Trusted Marketplace"
NEXT_PUBLIC_SITE_DESCRIPTION="A trusted multi-vendor marketplace for Sri Lanka"
